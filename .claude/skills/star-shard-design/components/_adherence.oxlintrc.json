{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Button/**",
              "components/general/Input/**",
              "components/general/ShardCard/**",
              "components/general/TarotCard/**",
              "components/general/Taskbar/**",
              "components/general/Window/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Varela Round|Pixelify Sans))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Varela Round, Pixelify Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShardCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|body|size|revealed|onReveal|style|key|ref|className|style|children)$/]",
        "message": "<ShardCard> doesn't accept that prop. Declared props: kind, title, body, size, revealed, onReveal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShardCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:house|mirror|moon|hearth)$/]",
        "message": "<ShardCard> kind must be one of 'house' | 'mirror' | 'moon' | 'hearth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarotCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|name|epithet|art|rare|faceDown|width|onFlip|style|key|ref|className|style|children)$/]",
        "message": "<TarotCard> doesn't accept that prop. Declared props: numeral, name, epithet, art, rare, faceDown, width, onFlip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Taskbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|children|trailing|key|ref|className|style|children)$/]",
        "message": "<Taskbar> doesn't accept that prop. Declared props: start, children, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|focused|onMinimize|onClose|children|style|key|ref|className|style|children)$/]",
        "message": "<Window> doesn't accept that prop. Declared props: title, icon, focused, onMinimize, onClose, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": [
          "button"
        ]
      },
      "Input": {
        "replaces": [
          "input"
        ]
      },
      "ShardCard": {
