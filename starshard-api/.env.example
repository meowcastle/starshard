NODE_ENV=production
PORT=4001
DB_SOCKET=/run/mysqld/mysqld10.sock
# Local dev alternative to DB_SOCKET (a plain TCP mysqld — Docker, Homebrew,
# etc. — has no unix socket to point at). If DB_HOST is set it takes
# priority over DB_SOCKET; DB_PORT defaults to 3306.
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_USER=starshard_app
DB_PASSWORD="change-me"
DB_NAME=starshard
JWT_SECRET=generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=https://staging.starshard.net
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Star Shard <no-reply@starshard.net>"
APP_URL=https://staging.starshard.net
ADMIN_TOKEN=generate-with-openssl-rand-hex-32

# Believe edge-supplied headers (CF-IPCountry, which the age gate uses to pick a
# region minimum). Leave unset until the API is behind the Cloudflare Tunnel AND
# direct origin access is blocked — until both are true the header is spoofable,
# and under the default 'country' policy that lets a caller talk a 16 minimum
# down to 13. Unset, the age gate uses the client's time zone, as it always has.
# TRUST_EDGE_HEADERS=1

# How the two region signals combine when both are present. Default 'country':
# the edge decides, the time zone fills in when the edge says nothing. Set to
# 'strictest' to take the higher of the two instead (harder to game, but it
# over-restricts travellers and VPN users).
# AGE_REGION_POLICY=country
